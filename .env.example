# Copy to .env.local and fill in. Nothing here is required to run the site —
# only to make the contact form actually deliver mail.

# Resend API key. Without it /api/contact answers 503 "not configured" and logs
# the message server-side rather than silently dropping it.
RESEND_API_KEY=

# Sender identity. Optional — the default lives in content/site.ts as
# site.mail.from. Set this only to override it without a code change.
# In a .env file the quotes are required; in Vercel's dashboard paste the value
# WITHOUT quotes, or they become part of the From header.
# CONTACT_FROM="Ajay Singh Parmar <hello@ajaysparmar.com>"

# Destination inbox. Defaults to `site.email` in content/site.ts.
# CONTACT_TO=

# PostHog. Without a key, telemetry is a complete no-op: no network requests, no
# cookies, and the consent bar never appears.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com — set only if your project is in the EU.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Logs every analytics event to the console and window.__analyticsLog instead of
# needing a real project. For local verification only.
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
